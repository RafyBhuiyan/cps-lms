# Where this app looks for the Strapi API.
#
# Public on purpose: NEXT_PUBLIC_* values are inlined into the browser bundle, and
# this one has to be, because every request in this app is made from the client
# with the user's own JWT. Nothing secret belongs in this file.
#
# Local development, with Strapi on its default port:
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# In production this is the Railway URL of the Strapi service, e.g.
# NEXT_PUBLIC_STRAPI_URL=https://cps-lms-backend.up.railway.app
