{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Question": {
      "type": "component",
      "component": "quiz-data.question",
      "repeatable": true
    },
    "quiz_results": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz-result.quiz-result",
      "mappedBy": "quiz"
    },
    "course": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course.course",
      "mappedBy": "final_quiz"
    },
    "parent_course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "practice_quizzes"
    },
    "lesson": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::lesson.lesson",
      "inversedBy": "quiz"
    }
  }
}
