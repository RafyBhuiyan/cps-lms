# Copy to .env for local development. Never commit the real .env — it is ignored.
#
# Every secret below must be a fresh random value per environment. Generate one
# with:  openssl rand -base64 32
# APP_KEYS takes four of them, comma-separated.

HOST=0.0.0.0
PORT=1337

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database ---------------------------------------------------------------
# Local development. `postgres` matches production; `sqlite` needs no server.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

# A single connection string overrides the DATABASE_HOST/NAME/USERNAME/PASSWORD
# values above (pg parses it last, so it wins). This is the form managed hosts
# hand you, so production sets only DATABASE_CLIENT and DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Frontend ---------------------------------------------------------------
# Origins allowed to call this API, comma-separated. Defaults to the local Next
# dev server; production lists the deployed frontend, plus any preview URL.
# FRONTEND_URL=https://cps-lms.vercel.app,https://cps-lms-git-main-you.vercel.app

# --- Behind a proxy (production) --------------------------------------------
# The public origin of this instance, so the admin panel knows where to call.
# PUBLIC_URL=https://cps-lms-backend.up.railway.app
#
# Set to true wherever TLS is terminated by a load balancer in front of Strapi,
# so X-Forwarded-Proto and X-Forwarded-For are trusted. See config/server.ts.
# IS_PROXIED=true
